{
  "name": "hadith-library",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source hadith and Quran library in many languages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-sources.mjs",
    "data": "node --max-old-space-size=12000 scripts/build-data.mjs && node scripts/build-grades.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/web.e2e.mjs && node tests/e2e/crawl.e2e.mjs",
    "preview": "node --max-old-space-size=8000 spa/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "adhan": "^4.4.6",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "vitest": "^2.1.9"
  }
}
